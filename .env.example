# Puerto del servidor local
PORT=3000

# URL Base del Banco Central (Laravel API)
# Ej: http://localhost:8000 o https://banco-central.coolify.tu-dominio.com
CENTRAL_BANK_URL=http://localhost:8000

# API Key generada por el Banco Central para este nodo ATM
ATM_API_KEY=tu_api_key_aqui

# Efectivo físico inicial cargado en el dispensador del cajero
INITIAL_LOCAL_CASH=5000.00

# Nombre del nodo cajero
ATM_NODE_NAME=ATM-CENTRO

# Ubicación o sucursal de adscripción del cajero
ATM_LOCATION=Sucursal Centro

# Modo de simulación (true para pruebas locales; false = producción con Banco Central)
MOCK_BANK=false

# Contraseña de acceso al panel administrativo del cajero
ATM_ADMIN_PASSWORD=admin1234
